# Copy to .env.local and fill in. Never commit real values.

# 1 = replay recorded fixtures, no keys needed
DEMO_MODE=1

# Convex (created by `npx convex dev` once Luca logs in)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# OutLayer, testnet only: https://testnet-api.outlayer.ai
OUTLAYER_API_URL=https://testnet-api.outlayer.ai
OUTLAYER_API_KEY=

# NEAR AI Cloud private inference
NEARAI_API_KEY=

# Telegram Stockbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BUYER_CHAT_ID=

# Inbound email webhook
INBOUND_EMAIL_SECRET=
DEMO_EMAIL_DOMAIN=

# Astro's OutLayer custody wallet (testnet): approvals, Gmail connector, dock check
OUTLAYER_WALLET_ID=
OUTLAYER_NEAR_ACCOUNT=
OUTLAYER_PAYMENT_KEY=
OUTLAYER_OWNER_ACCOUNT=
NEARAI_MODEL=
DOCK_CHECK_WASM_SHA256=

# Testnet rehearsal (npm run rehearse; RECORD=1 writes fixtures/recorded)
RECORD=0
REHEARSE_ULTRA_ACCOUNT=
REHEARSE_HAOYUN_ACCOUNT=
REHEARSE_HAOYUN_EMAIL=
# Optional: polling interval in ms and a divisor for OutLayer testnet amounts
REHEARSE_POLL_MS=2000
REHEARSE_SCALE=1

# NEAR Intents Agent API: per-PO escrow and payout. Default is Tidepool, a community-run testnet
# not affiliated with NEAR. Mainnet (https://api.agentsonintents.com) only with Luca's explicit yes.
AGENT_API_BASE_URL=https://www.usetidepool.tech
AGENT_API_KEY=
# Astro's dedicated owner on Tidepool: an implicit testnet account (ed25519). Never a founder wallet.
AGENT_OWNER_ACCOUNT_ID=
AGENT_OWNER_PUBLIC_KEY=
AGENT_OWNER_PRIVATE_KEY_PKCS8=
# Astro's treasury agent on Tidepool: funds each PO account and takes the held part back
AGENT_TREASURY_ID=
# Haoyun's Base Sepolia receiving address (public); its demo key stays in .env.local only
HAOYUN_BASE_ADDRESS=

# Release gate (worker/release-gate), an OutLayer WASI module run directly on testnet. Leave
# RELEASE_GATE_WASM_URL empty and Evernear's server sends each release, saying so on every proof.
# Set it and every release is sent from the enclave; then the other two are required.
# The FastFS URL and sha256 that `outlayer upload` printed for the build Astro approved
RELEASE_GATE_WASM_URL=
RELEASE_GATE_WASM_SHA256=
# The testnet custody wallet key (wk_) of Evernear's NEAR account, which signs every run (the gate's keys are bound to it)
# The account that signs every gate run (the gate's keys are bound to it) and its NEAR key, Convex env only.
RELEASE_GATE_NEAR_ACCOUNT=
RELEASE_GATE_NEAR_KEY=
# The signer's OutLayer secrets profile holding AGENT_API_KEY for the gate's wasm hash (default: default).
RELEASE_GATE_SECRETS_PROFILE=
# Or, instead of a NEAR key, an OutLayer custody wallet key.
RELEASE_GATE_WALLET_KEY=
# Optional: the gate's result key from a first enroll, pinned so a different key is refused
RELEASE_GATE_PUBLIC_KEY=
# Optional: testnet NEAR attached to each run, in yocto (default 0.1 NEAR, unused part refunded)
RELEASE_GATE_DEPOSIT_YOCTO=

# Set to 1 once worker/release-gate is deployed and live releases go through it; the explainers then say only the enclave can release.
NEXT_PUBLIC_RELEASE_GATE_DEPLOYED=0
