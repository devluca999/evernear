# Copy to .env.local and fill in. Never commit real values.

# 1 = replay recorded fixtures, no keys needed
DEMO_MODE=1

# Convex (created by `npx convex dev` once Luca logs in)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# OutLayer, testnet only: https://testnet-api.outlayer.ai
OUTLAYER_API_URL=https://testnet-api.outlayer.ai
OUTLAYER_API_KEY=

# NEAR AI Cloud private inference
NEARAI_API_KEY=

# Telegram Stockbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BUYER_CHAT_ID=

# Inbound email webhook
INBOUND_EMAIL_SECRET=
DEMO_EMAIL_DOMAIN=

# Finale only (mainnet, small amounts, needs Luca's explicit yes)
FINALE_ENABLED=0
OUTLAYER_WALLET_ID=
OUTLAYER_NEAR_ACCOUNT=
OUTLAYER_PAYMENT_KEY=
OUTLAYER_OWNER_ACCOUNT=
NEARAI_MODEL=
DOCK_CHECK_WASM_SHA256=
